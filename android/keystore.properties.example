# Copy this file to android/keystore.properties (git-ignored) and fill in your release keystore details.
# Or export CARDLEDGER_STORE_FILE, CARDLEDGER_STORE_PASSWORD, CARDLEDGER_KEY_ALIAS, CARDLEDGER_KEY_PASSWORD.
storeFile=release-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=cardledger
keyPassword=YOUR_KEY_PASSWORD
